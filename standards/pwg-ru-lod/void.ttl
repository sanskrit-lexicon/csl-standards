# VoID + DCAT dataset descriptor for the PWG->RU LOD graph.
#
# Filled from the real full-graph build of 2026-10-11 (docs/PUBLISHING_LOD.md
# section 8): counts below are from that build, not the fixture. The version
# DOI slot stays open until the section-6 Zenodo deposit rides the preview
# release. See PROVENANCE.md in this directory for the build command, inputs,
# the section-1b safety verdict and the section-1c license composition record.

@prefix void:    <http://rdfs.org/ns/void#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix pwglex:  <https://w3id.org/sanskrit-lexicon/repwg/vocab#> .
@prefix :        <https://w3id.org/sanskrit-lexicon/repwg/> .

:dataset a void:Dataset , dcat:Dataset ;
  dcterms:title       "PWG->RU LOD graph — Petersburg Dictionary senses, Russian, OntoLex-Lemon + LiLa lemma bank"@en ;
  dcterms:description  "TECHNICAL PREVIEW — MACHINE TRANSLATION, NOT YET HUMAN-REVIEWED — NOT CITABLE. Linked-Open-Data graph of the Petersburg Sanskrit Dictionary (Boehtlingk-Roth, public domain) with Russian sense definitions produced by machine translation and graded gr:machine-preview (dictionary-layer senses graded gr:dict-attested); evidence grades (PROV-O), first-class <ls> citations, vartrans sense relations, and a LiLa-style lemma bank joined to DCS corpus frequency. The citable subset is a SPARQL filter — ?s pwglex:evidenceGrade ?g . FILTER(?g IN (gr:approved, gr:human-reviewed)) — and is currently EMPTY: no human-approved senses exist yet (release posture ruling (B), MG 11-10-2026). Do not cite the translations; the value of this release is the graph shape."@en ;
  dcterms:license     <https://creativecommons.org/licenses/by-sa/4.0/> ;
  dcterms:rights      "Project's own work under CC BY-SA 4.0. Third-party layers: DCS (Digital Corpus of Sanskrit, Oliver Hellwig, 2010-2024) frequency data is CC BY 4.0 — composition verdict COMPOSE (no term stricter than CC BY-SA 4.0), recorded with verbatim terms in PROVENANCE.md. Kochergina/Frisch/Smirnov gloss layers are used under recorded copyright approvals with per-sense attribution (dct:source). Knauer/Kossowich layers are public domain."@en ;
  dcterms:publisher   [ a foaf:Person ;
                        foaf:name "Dr. Marcis Gasuns" ;
                        <http://www.w3.org/2002/07/owl#sameAs> <https://orcid.org/0000-0003-4513-884X> ] ;
  dcterms:creator     <https://orcid.org/0000-0003-4513-884X> ;
  # NOTE (section 6): the Zenodo version DOI is minted when the preview release
  # rides (after steps 1b-5 land); slot intentionally left open in wave-0.
  dcterms:hasVersion  "tech-preview-2026-10-11" ;
  dcterms:modified    "2026-10-11"^^xsd:date ;

  void:feature        <http://www.w3.org/ns/formats/Turtle> ;
  void:vocabulary     ontolex: , pwglex: ;
  void:uriSpace       "https://w3id.org/sanskrit-lexicon/repwg/" ;
  void:exampleResource :entry/rakz ;

  # ---- the two graphs (the cross-dataset join is on the shared lemma IRI) ----
  void:subset :lexicalGraph , :dcsFreqGraph ;

  # ---- counts from `python src/export_lod.py all --base-iri .../repwg/` ----
  void:entities       "363633"^^xsd:integer ;
  void:triples        "367987"^^xsd:integer ;
  void:classPartition [ void:class ontolex:LexicalEntry ; void:entities "120172"^^xsd:integer ] ,
                      [ void:class ontolex:LexicalSense  ; void:entities "48579"^^xsd:integer ] ,
                      [ void:class pwglex:Citation       ; void:entities "35778"^^xsd:integer ] ;

  # ---- static surface (section 4 ruling: static dump first) ----
  dcat:distribution [ a dcat:Distribution ;
                      dcterms:title "Full lexical graph (Turtle, gzip — under the 100 MB git file cap)"@en ;
                      dcat:accessURL <https://sanskrit-lexicon.github.io/pwg-ru-lod/pwg_ru_lod.ttl.gz> ;
                      dcat:mediaType <http://www.w3.org/ns/formats/Turtle> ] ,
                    [ a dcat:Distribution ;
                      dcterms:title "DCS lemma-frequency graph (Turtle dump)"@en ;
                      dcat:accessURL <https://sanskrit-lexicon.github.io/pwg-ru-lod/dcs_freq.ttl> ;
                      dcat:mediaType <http://www.w3.org/ns/formats/Turtle> ] .

:lexicalGraph a void:Dataset ;
  dcterms:title "PWG->RU lexical graph (entries, senses, citations, relations)"@en ;
  void:triples  "324279"^^xsd:integer .

:dcsFreqGraph a void:Dataset ;
  dcterms:title "DCS corpus-frequency graph (pwglex:dcsCount / dcsBand on the shared lemma IRI)"@en ;
  void:triples  "43708"^^xsd:integer .

# Links to the standards surface in this directory:
#   - SHACL profile:    shapes.ttl
#   - acceptance query: sense_citation_dcsfreq.rq
#   - build provenance: PROVENANCE.md
# and the model doc: RussianTranslation/LOD_GRAPH.md (in gasyoun/SanskritLexicography).
