<https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006> a skos:ConceptScheme ;
  dct:title "Small-class abbreviation register after Gasūns 2006 (EURALEX XII, pp. 773–778, §2.3), grounded in the CDSL abbreviation census (H6409); v2 extends beyond the scheme-as-printed with the measured-residue classes (gender/features, work titles, authors/editors) and externally grounds the 2006 forms the census does not evidence"@en ;
  scr:registerVersion "2.0.0" ;
  scr:paper [ dct:creator "Mārcis Gasūns" ; dct:title "Latin Terms in Sanskrit Dictionaries" ; dct:bibliographicCitation "EURALEX XII Proceedings, Lexicography for Specialised Languages — Terminology and Terminography, Torino, pp. 773–778" ; dct:issued "2006"^^xsd:gYear ; rdfs:seeAlso <https://github.com/gasyoun/Uprava/blob/main/research/notes/latin-terms-2006-fulltext.md> ] ;
  scr:census [ dct:source "csl-atlas/data/abbrev/abbrev_census.json" ; scr:handoff "H6409" ; scr:generatedAt "2026-10-10T19:00:00.879Z"^^xsd:dateTime ; scr:corpusCommit "f4c08c578b330e2379e38f54d3a541f1564b8eee" ] ;
  scr:lex0Pin "TEI Lex-0 baseline 0.9.5 (DARIAH-ERIC/lexicalresources; estate pin per docs/A70_TEI_LEX0_INDIGENOUS_APPARATUS_NOTE.md)" ;
  scr:skosRef "https://www.w3.org/TR/skos-reference/" ;
  scr:jsonLdStyle "JSKOS-style field conventions per gbv/jskos (notation @set, prefLabel/altLabel @language)" ;
  scr:adjacent "H5335 lexicographic-types register (SanskritLexicography docs/DECISION_BRIEF_LEXICOGRAPHIC_TYPES_REGISTER_H5335_24-09-2026.md) — dictionary-genre taxonomy, a different layer; cross-linked, not duplicated" .

<https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#2006-1> a skos:Collection ;
  skos:prefLabel "2006 one-letter small class"@en ;
  skos:definition "Abbreviations of one letter: cases and voices."@en ;
  scr:paperQuote "One-letter abbreviation: a) for cases \"N[ominative].\", \"G[enetive].\", \"L[ocative].\" and combinations involving cases (without the dot sign to economize space) as IDAbl., NA. and GL. (Kn) instead of Ab.G., D.Ab. (Mc). b) for voices 'Ä', 'A', 'P', 'p'"@en ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#active> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#atmanepada> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#genitive> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#locative> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#nominative> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#parasmaipada> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#passive> .

<https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#2006-2> a skos:Collection ;
  skos:prefLabel "2006 two-letter small class"@en ;
  skos:definition "Abbreviations of two letters: persons (number) and participium."@en ;
  scr:paperQuote "Two-letter abbreviations: a) for persons sg. du. pl. instead of sing. or plur. b) participium pp. pn."@en ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#dual> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#past-passive-participle> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#plural> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#singular> .

<https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#2006-3> a skos:Collection ;
  skos:prefLabel "2006 three-letter small class"@en ;
  skos:definition "Abbreviations of three letters: voices, moods, languages."@en ;
  scr:paperQuote "Three-letter abbreviations: a) for voices Atrn., Par. (Bf) b) moods Inj., Ipv., Ipf, Ppf., Prc, Gdv., Inf., in small caps (Mc) c) languages skt. pkr. (Kn), Ssk. (Bf)"@en ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#gerundive> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#imperative> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#imperfect> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#infinitive> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#pluperfect> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#prakrit> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#sanskrit> .

<https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#2006-4> a skos:Collection ;
  skos:prefLabel "2006 four-letter small class"@en ;
  skos:definition "Abbreviations of four letters: moods, participium, miscellaneous."@en ;
  scr:paperQuote "Four-letter abbreviations: a) for moods caus. pass. b) participium ppfa. pfph. c) miscellaneous onom[apoetic]. (MC)"@en ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#causal> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#onomatopoeic> .

<https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#v2-authors-editors> a skos:Collection ;
  skos:prefLabel "v2 author/editor class (measured residue)"@en ;
  skos:definition "Author and editor abbreviations evidenced by the census on the colliding strings; measured extension beyond the 2006 scheme-as-printed (MG verdicts 10-10-2026), under the same census-grounding rules."@en ;
  scr:paperQuote "\"V.\" — … Vopadeva (Rn) … the Sanskrit-Wörterbuch (W) printed in Petersburg (P) by Otto Böhtlingk (B) and Rudolph Roth (R), großes (G) and after that kleines (K)"@en ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#bohtlingk> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#brockhaus> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#vopadeva> .

<https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#v2-gender-features> a skos:Collection ;
  skos:prefLabel "v2 gender and features class (measured residue)"@en ;
  skos:definition "Gender and voice-feature abbreviations evidenced by the census on the single-letter residue; measured extension beyond the 2006 scheme-as-printed (MG verdicts 10-10-2026), under the same census-grounding rules."@en ;
  scr:paperQuote "\"f.\" — reserved for \"femininum\", occasionally comes across as \"futurum\" (Kn) and \"for\" (Mc) … \"m\" — masculinum (Ko, Wb), mitten (Bt) … \"N.\" — … neuter (Ln, Wb)"@en ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#feminine> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#masculine> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#middle> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#neuter> .

<https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#v2-work-titles> a skos:Collection ;
  skos:prefLabel "v2 work-title class (measured residue)"@en ;
  skos:definition "Work-title abbreviations evidenced by the census on the colliding strings; measured extension beyond the 2006 scheme-as-printed (MG verdicts 10-10-2026), under the same census-grounding rules."@en ;
  scr:paperQuote "\"N.\" — … Naishadhacarita (Ap), Nyāsa (Rn), Nala (Kn) … \"M.\" — Manu (Wh, Wg, Kn) … \"P.\" — Pānini's Ashthadyāyī (Wg, Ap, Rn) … as in \"MS.\" Maitrāyaṇīsaṁhitā …, \"AV.\" Atharvavedasaṁhitā (Wg)"@en ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#atharvaveda> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#malavikagnimitra> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#manu> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#matsyopakhyana> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#naishadhacarita> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#nalopakhhyana> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#paninis-ashtadhyayi> ;
  skos:member <https://sanskrit-lexicon.github.io/csl-standards/registers/small-class-2006#vikramorvashiyam> .

