<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="csl-tei-lex0-profile-odd">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>CSL Standards TEI Lex-0 Profile ODD</title>
      </titleStmt>
      <publicationStmt>
        <publisher>CSL Standards</publisher>
        <availability>
          <licence target="https://creativecommons.org/licenses/by-sa/4.0/">CC-BY-SA-4.0</licence>
        </availability>
      </publicationStmt>
      <sourceDesc>
        <p>Project ODD for the generated CDSL TEI Lex-0 baseline entries
        (<ref target="../../docs/TEI_LEX0_PILOT.md">docs/TEI_LEX0_PILOT.md</ref>).
        It customises the DARIAH TEI Lex-0 baseline element set for the MW-PWG-PWK
        pilot and the indigenous SKD <foreign>kośa</foreign> case. Distinct from
        the archival profile (<ref target="tei-archival-profile.odd.xml">tei-archival-profile.odd.xml</ref>):
        Lex-0 entries promote lexical structure into TEI dictionary elements and
        do NOT carry the archival <gi>cit</gi> <att>type</att> source-entry raw
        quotes.</p>
      </sourceDesc>
    </fileDesc>
    <revisionDesc>
      <change when="2026-06-14">Created: project Lex-0 ODD + RNG validation wiring (TEI_LEX0_PILOT sec. 7.1).</change>
      <change when="2026-09-24">Added csl-lex0-skd-indigenous-apparatus: zero-meaning, anubandha and M4-decode constraints plus lex0-gap witnesses for the stratified Śabdakalpadruma sample (H5321).</change>
    </revisionDesc>
  </teiHeader>
  <text>
    <body>
      <schemaSpec ident="csl-tei-lex0-profile-v0.1" start="TEI">
        <moduleRef key="tei"/>
        <moduleRef key="header"/>
        <moduleRef key="core"/>
        <moduleRef key="textstructure"/>
        <moduleRef key="dictionaries"/>
        <moduleRef key="linking"/>
        <moduleRef key="namesdates"/>
        <moduleRef key="analysis"/>
        <!-- The TEI Lex-0 baseline element set, as used by the generator:
             entry, form/orth, gramGrp (pos, gen, gram), sense/def, cit/quote,
             bibl, etym, usg, re, xr/ref. Each statement binds its epistemic
             status to @cert/@resp (docs/EVIDENCE_LABEL_CROSSWALK.md). -->
        <constraintSpec ident="csl-lex0-baseline-shape" scheme="schematron">
          <constraint>
            <sch:pattern xmlns:sch="http://purl.oclc.org/dsdl/schematron">
              <sch:rule context="tei:TEI">
                <sch:assert test="@xml:id">Every Lex-0 document has a stable case xml:id.</sch:assert>
                <sch:assert test="tei:teiHeader">Every Lex-0 document has a teiHeader.</sch:assert>
              </sch:rule>
              <sch:rule context="tei:entry">
                <sch:assert test="@xml:id">Each entry has a stable xml:id.</sch:assert>
                <sch:assert test="tei:form[@type='lemma']/tei:orth">Each entry has a lemma form with an orthographic form.</sch:assert>
                <sch:assert test="tei:form/tei:orth/@cert">The lemma orth carries an epistemic @cert.</sch:assert>
                <sch:assert test="tei:gramGrp or tei:sense">Each entry has a gramGrp or at least one sense.</sch:assert>
                <sch:assert test="tei:note[@type='profile-version'] = 'tei-lex0-pilot-v0.1'">Each entry declares the Lex-0 profile version.</sch:assert>
                <sch:assert test="not(tei:cit[@type='source-entry'])">A Lex-0 entry must NOT carry the archival source-entry raw quote (that is the archival profile).</sch:assert>
              </sch:rule>
              <sch:rule context="tei:sense">
                <sch:assert test="tei:def or tei:xr or tei:note">Each sense carries a definition, a cross-reference, or an explanatory note.</sch:assert>
              </sch:rule>
            </sch:pattern>
          </constraint>
        </constraintSpec>
        <!-- Kośa sense-boundary customisation (TEI_LEX0_PILOT sec. 5). In an
             indigenous kośa the closing authority formula ("iti <authority>") is
             the boundary of the sense unit, not detachable apparatus. The Lex-0
             baseline can only split it into <def> + <bibl>; this profile records
             that split as a deliberate, documented customisation rather than a
             silent flattening. SKD entries (xml:id starting "skd-") therefore
             carry the authority as a <bibl> inside the <sense> it closes, and a
             model-loss note witnessing the fused iti-unit. -->
        <constraintSpec ident="csl-lex0-kosa-sense-boundary" scheme="schematron">
          <constraint>
            <sch:pattern xmlns:sch="http://purl.oclc.org/dsdl/schematron">
              <!-- A kośa entry declares the iti-unit convention explicitly. -->
              <sch:rule context="tei:entry[tei:note[@type='entry-convention'] = 'kosa-iti-unit']">
                <sch:assert test="tei:sense/tei:bibl[@type='kosa-authority']">A kośa entry has at least one sense closed by an authority formula (bibl type="kosa-authority").</sch:assert>
              </sch:rule>
              <!-- The closing authority formula is the sense boundary: the iti-unit
                   it bounds must witness the sense/citation fusion as a model-loss. -->
              <sch:rule context="tei:sense[tei:bibl[@type='kosa-authority']]">
                <sch:assert test="tei:note[@type='model-loss']">A kośa sense closed by an authority formula (iti X) records the sense/citation-fusion as a model-loss, so the fusion is declared rather than silently flattened.</sch:assert>
                <sch:assert test="tei:def">A kośa iti-unit carries its synonym run as a def.</sch:assert>
              </sch:rule>
            </sch:pattern>
          </constraint>
        </constraintSpec>
        <!-- Indigenous-apparatus customisation (H5321, docs/TEI_LEX0_SKD_GAPS.md).
             Zero-meaning doctrine: in the Śabdakalpadruma the absence of a marker
             is a statement, not missing data. An empty anubandha slot is encoded
             as gram type="anubandha" norm="none" and must be explained; pada,
             gaṇa and transitivity are the M4 (csl-atlas Dhātudīpikā) decode and
             must say so in @resp — a derived reading never passes as source
             text. Every structure without a Lex-0 home is witnessed on the entry
             as note type="lex0-gap" with a registry id (G1…Gn). -->
        <constraintSpec ident="csl-lex0-skd-indigenous-apparatus" scheme="schematron">
          <constraint>
            <sch:pattern xmlns:sch="http://purl.oclc.org/dsdl/schematron">
              <sch:rule context="tei:entry[tei:gramGrp/tei:gram[@type='anubandha'][@norm='none']]">
                <sch:assert test="tei:note[@type='zero-meaning']">An empty anubandha slot is the source's statement "no anubandha": the entry explains it in a zero-meaning note.</sch:assert>
                <sch:assert test="tei:note[@type='lex0-gap'][@n='G3']">An empty anubandha slot witnesses the zero-meaning gap (G3).</sch:assert>
              </sch:rule>
              <sch:rule context="tei:gram[@type='anubandha'][not(@norm='none')]">
                <sch:assert test="@resp='#source'">An anubandha letter is read as printed (resp="#source").</sch:assert>
                <sch:assert test="ancestor::tei:entry/tei:note[@type='lex0-gap'][@n='G2']">A printed anubandha slot witnesses the anubandha gap (G2).</sch:assert>
              </sch:rule>
              <sch:rule context="tei:gram[@type='gana' or @type='pada' or @type='transitivity' or @type='it-augment']">
                <sch:assert test="@resp='#m4'">Gaṇa, pada, transitivity and it-augment are the M4 decode, never source text (resp="#m4").</sch:assert>
              </sch:rule>
              <sch:rule context="tei:note[@type='lex0-gap']">
                <sch:assert test="matches(@n, '^G[0-9]+$')">A lex0-gap note carries its registry id (G1…Gn) in @n.</sch:assert>
                <sch:assert test="starts-with(ancestor::tei:entry/@xml:id, 'skd-')">lex0-gap notes belong to indigenous (SKD) entries.</sch:assert>
              </sch:rule>
              <sch:rule context="tei:entry[starts-with(@xml:id, 'skd-')]">
                <sch:assert test="//tei:bibl[@xml:id='dict-skd']">An SKD entry's document declares its source dictionary (bibl xml:id="dict-skd").</sch:assert>
                <sch:assert test="not(tei:gramGrp/tei:gram[@resp='#m4']) or //tei:respStmt[@xml:id='m4']">A document using the M4 decode declares the m4 respStmt.</sch:assert>
              </sch:rule>
            </sch:pattern>
          </constraint>
        </constraintSpec>
      </schemaSpec>
    </body>
  </text>
</TEI>
