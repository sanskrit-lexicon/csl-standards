        </form>
        <gramGrp>
          <pos norm="verb" cert="high" resp="#machine">verb</pos>
          <gram type="anubandha" norm="none" cert="high" resp="#source">none</gram>
          <gram type="gana" norm="bhvadi" cert="high" resp="#m4">bhvādi</gram>
          <gram type="pada" norm="parasmaipada" cert="high" resp="#m4">parasmaipada</gram>
          <gram type="transitivity" norm="sakarmaka" cert="high" resp="#m4">sakarmaka</gram>
