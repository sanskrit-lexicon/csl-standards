        <sense xml:id="skd-aDirohiRI-sense-2" n="2">
          <def xml:lang="sa-Latn" cert="high" resp="#source">niḥśreṇī; adhirohaṇo ityapi pāṭhaḥ</def>
        </sense>
        <note type="lex0-gap" n="G1">iti-unit: sense and closing authority fused</note>
        <note type="lex0-gap" n="G5">Paryāya run: an authority&apos;s numbered synonym list</note>
