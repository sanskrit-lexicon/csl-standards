        <etym xml:id="skd-aDirohiRI-etym" subtype="derivation"><lbl>from</lbl> <hi rend="mentioned" xml:lang="sa">adhi + roha</hi> <note type="analysis" xml:lang="sa-Latn" resp="#source">adhirohaḥ ārohaṇaṃ tadeva sādhanatvena vidyade&apos;sya adhi + roha + in striyāṃ ṅīp .</note></etym>
