      <entry xml:id="skd-apa-entry" xml:lang="sa">
        <form type="lemma">
          <orth notation="SLP1" xml:lang="sa-Latn-x-SLP1" cert="high" resp="#source">apa</orth>
        </form>
        <gramGrp>
          <gram type="pos" norm="indeclinable" cert="high" resp="#machine">indeclinable</gram>
          <gram type="linga" cert="high" resp="#source">vya</gram>
        </gramGrp>
        <etym xml:id="skd-apa-etym" subtype="derivation"><lbl>from</lbl> <hi rend="mentioned" xml:lang="sa">na + pā</hi> <note type="analysis" xml:lang="sa-Latn" resp="#source">na pāti, na + pā + ḍa “cādayo&apos;sattve” iti nipātasaṃjñayā svarādinipātamavyayamiti avyayam .</note></etym>
        <sense xml:id="skd-apa-sense-1" n="1">
          <def xml:lang="sa-Latn" cert="high" resp="#source">upasargaviśeṣaḥ; asyārthaḥ; anādaraḥ; bhraṃśaḥ; asākalyaṃ; vairūpyaṃ; tyāgaḥ; nañarthaḥ</def>
          <cit type="example">
            <bibl type="kosa-authority"><author>Durgādāsa</author></bibl>
          </cit>
          <note type="model-loss" resp="#source">Sense and its closing authority (iti Durgādāsa) are one indivisible iti-unit in the source, split into def + bibl in the Lex-0 baseline.</note>
        </sense>
        <sense xml:id="skd-apa-sense-2" n="2">
          <def xml:lang="sa-Latn" cert="high" resp="#source">apakṛṣṭārthaḥ; varjjanārthaḥ; viyogaḥ; viparyyayaḥ; vikṛtiḥ; cauryyaṃ; nirddeśaḥ; harṣaḥ</def>
          <cit type="example">
            <bibl type="kosa-authority"><title>Medinī</title></bibl>
          </cit>
          <note type="model-loss" resp="#source">Sense and its closing authority (iti Medinī) are one indivisible iti-unit in the source, split into def + bibl in the Lex-0 baseline.</note>
        </sense>
        <note type="lex0-gap" n="G1">iti-unit: sense and closing authority fused</note>
        <note type="lex0-gap" n="G10">Liṅga-based word class (triliṅga, avyaya)</note>
        <note type="model-loss" resp="#source">Source-parsed indigenous kosa entry: meanings/synonyms are grouped by their closing authority (iti &lt;author&gt;), the kosa&apos;s own sense-and-citation unit.</note>
        <note type="entry-convention" resp="#source">kosa-iti-unit</note>
        <note type="source-record">skd L1368</note>
        <note type="profile-version">tei-lex0-pilot-v0.1</note>
