\lx as
\hm 1
\ps cl. 2
\sn 1
\ge to be, live, exist, be present
\sn 2
\ge to take place, happen
\sn 3
\ge to abide, dwell, stay
\sn 4
\ge to belong to
\sn 5
\ge to fall to the share of, happen to any one
\sn 6
\ge to be equal to
\sn 7
\ge to turn out, tend towards any result, prove
\sn 8
\ge to become, etc
